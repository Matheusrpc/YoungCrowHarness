# segredos e estado local / secrets and local state
.env
*.local
pgdata/
.runtime/
.operacao-local/
/vault/local/
/examples/delivery-board/vault/local/

# caches
__pycache__/
*.pyc
/docs/medicoes/setup-audit-*/
/%SystemDrive%/
node_modules/
.playwright-cli/

# evidência pesada nunca entra: HTML com base64 fora, JPG/PNG de captura dentro
# heavy evidence stays out: base64 HTML out, JPG/PNG screenshots in
**/prancha/*.html
**/*.base64.html

# skills de terceiros instaladas localmente (o setup.sh instala do upstream)
.agents/skills/*/
!.agents/skills/integrate-from-docs/
!.agents/skills/personalizer/

# impeccable-ignore-start
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/review/
.impeccable/questions/
.impeccable/live/
# impeccable-ignore-end
/.operacao-local/docling/
/.operacao-local/memory/
/.operacao-local/capabilities/
/.operacao-local/execution/
!.agents/skills/ingest-source/

!.agents/skills/retrieve-memory/
!.agents/skills/govern-capabilities/
!.agents/skills/yc-personalizer/
!.agents/skills/yc-config/
!.agents/skills/yc-missao/
!.agents/skills/yc-status/
